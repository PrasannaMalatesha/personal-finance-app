# Production feature flags for the Vercel build. Must mirror the backend
# FLAG_* values in render.yaml — the UI only shows a feature when both sides
# agree. Non-secret, so committed. VITE_API_BASE_URL is set in the Vercel
# dashboard (environment-specific), not here.

# Enabled — v2/v3 features with no external dependency.
VITE_FLAG_RECURRING=true
VITE_FLAG_MULTI_CURRENCY=true
VITE_FLAG_NET_WORTH=true
VITE_FLAG_HIERARCHICAL_CATEGORIES=true
VITE_FLAG_RULE_LEARNING=true

# Off until real credentials are configured (Plaid / Google OAuth / Resend).
VITE_FLAG_PLAID=false
VITE_FLAG_OAUTH=false
VITE_FLAG_PASSWORD_RESET=false

# Plaid tier badge — must match the backend PLAID_ENV. Sandbox by default.
VITE_PLAID_ENV=sandbox
