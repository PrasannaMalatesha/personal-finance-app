# Local dev: leave VITE_API_BASE_URL empty. Vite dev server proxies
# /api and /healthz to localhost:3001 (see vite.config.ts).
#
# Prod (Vercel): set VITE_API_BASE_URL to the deployed backend origin,
# WITHOUT a trailing /api/v1 (that's included in the fetch paths).
# Example: https://personal-finance-api.onrender.com
VITE_API_BASE_URL=

# Optional Sentry DSN for frontend error reporting.
VITE_SENTRY_DSN=

# Feature flags — all default off.
VITE_FLAG_PLAID=false
VITE_FLAG_RECURRING=false
VITE_FLAG_MULTI_CURRENCY=false
