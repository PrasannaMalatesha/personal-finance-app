NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://pfa:pfa_dev_password@localhost:5432/pfa_dev

# JWT secrets — must be >=32 chars and DIFFERENT from each other
JWT_ACCESS_SECRET=change-me-locally-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-differently-min-32-characters-secret

# Cookies
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:5173

# Sentry (optional; leave empty to disable)
SENTRY_DSN=

# Feature flags — all default off
FLAG_PLAID=false
FLAG_RECURRING=false
FLAG_MULTI_CURRENCY=false
