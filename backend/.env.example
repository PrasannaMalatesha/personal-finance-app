# Local development defaults. Real .env is gitignored.
# In production, set these in your host's dashboard (Render for backend);
# do NOT copy the dev values.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Postgres — matches docker-compose.yml. In prod, this is the Neon
# connection string (with ?sslmode=require).
DATABASE_URL=postgres://pfa:pfa_dev_password@localhost:5432/pfa_dev

# JWT secrets. Both must be >=32 chars AND different from each other. In
# prod, generate with: `openssl rand -base64 48` (twice, one per var).
JWT_ACCESS_SECRET=change-me-locally-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-differently-min-32-characters-secret

# Cookies. In dev, leave COOKIE_DOMAIN empty so the browser scopes cookies
# to localhost. In prod on a subdomain-split setup (api.foo.com + foo.com),
# set to `.foo.com` so cookies work across both. On split-origin platforms
# like Vercel + Render (different registrable domains), leave empty and
# rely on SameSite=Lax + credentials: 'include' — the browser scopes to
# the API host and sends it back on same-site XHRs.
COOKIE_DOMAIN=

# Where the frontend runs. Used for CORS. In prod, set to the full
# Vercel URL, e.g. https://personal-finance-app.vercel.app.
FRONTEND_ORIGIN=http://localhost:5173

# Sentry — leave empty to disable. Enable in prod for error tracking.
SENTRY_DSN=

# Feature flags — all default off. Gate v2 work behind these.
FLAG_PLAID=false
FLAG_RECURRING=false
FLAG_MULTI_CURRENCY=false
FLAG_NET_WORTH=false
FLAG_HIERARCHICAL_CATEGORIES=false
FLAG_PASSWORD_RESET=false
FLAG_RULE_LEARNING=false
FLAG_OAUTH=false

# Password reset email provider (Resend). Leave empty to fall back to the
# console adapter (reset URL logged server-side). Set both to enable
# real email sending in prod.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Plaid — sandbox tier for the demo. Grab client_id + sandbox secret from
# https://dashboard.plaid.com after signing up (free). Both required to
# enable /plaid/* routes; leave empty and the frontend hides Connect UI.
# Sandbox login inside Plaid Link: user_good / pass_good.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# AES-256-GCM key for encrypting Plaid access tokens at rest. Base64-encoded
# 32 bytes. REQUIRED for PLAID_ENV=development or production; may be left
# empty for sandbox (tokens land plaintext for zero-config dev). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_ENCRYPTION_KEY=

# Google OAuth — sign in with Google. Create a project + OAuth 2.0 client
# at https://console.cloud.google.com/apis/credentials (Application type:
# Web application). Register both localhost + prod redirect URIs:
#   http://localhost:3001/api/v1/auth/oauth/google/callback
#   https://<your-render-host>/api/v1/auth/oauth/google/callback
# Both keys required together to enable the /auth/oauth/google/* routes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public origin of this backend. Used to build the Google redirect URI.
# In dev, matches PORT above; in prod, the Render URL (no trailing slash).
API_BASE_URL=http://localhost:3001
